{
  "rewrites": [
    {
      "source": "/llms.txt",
      "destination": "/api/llms/txt"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/api/llms-full/txt"
    },
    {
      "source": "/blog/:slug.md",
      "destination": "/api/blog-md/:slug"
    },
    {
      "source": "/index.md",
      "destination": "/api/page-md/index"
    },
    {
      "source": "/work.md",
      "destination": "/api/page-md/work"
    },
    {
      "source": "/blog.md",
      "destination": "/api/page-md/blog"
    }
  ]
}
