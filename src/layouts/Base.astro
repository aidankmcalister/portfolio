---
import "@fontsource/spectral/latin-500-italic.css";
import spectralItalic from "@fontsource/spectral/files/spectral-latin-500-italic.woff2?url";
import "../styles/global.css";
import { SITE } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  // Key of this page's generated card in src/pages/og/[...route].ts.
  og?: string;
  // This page's markdown version, for agents.
  md?: string;
  // Wide layout: the home page's two columns on large screens.
  wide?: boolean;
  // A blog post: tagged as an article with its publish date.
  published?: string;
  // Pages search engines shouldn't list (the 404).
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  og = "index",
  md,
  wide = false,
  published,
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : SITE.name;
// Canonical URLs match the links the site uses: no trailing slash except the root.
const path = Astro.url.pathname.replace(/(.)\/$/, "$1");
const canonical = new URL(path, SITE.url).href;
const ogImage = new URL(`/og/${og}.png`, SITE.url).href;
const ogTitle = title ?? SITE.name;
// The card shows the title (or the name and role) in Spectral italic.
const imageAlt = title ?? `${SITE.name}, ${SITE.role}`;

const person = {
  "@type": "Person",
  name: SITE.name,
  url: SITE.url,
  jobTitle: SITE.role,
  email: `mailto:${SITE.email}`,
  sameAs: [SITE.social.github, SITE.social.linkedin],
};
const jsonLd = published
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      datePublished: published,
      url: canonical,
      image: ogImage,
      author: person,
    }
  : { "@context": "https://schema.org", ...person };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="me" href={SITE.social.github} />
    <link rel="me" href={SITE.social.linkedin} />
    <link rel="preload" href={spectralItalic} as="font" type="font/woff2" crossorigin />
    {md && <link rel="alternate" type="text/markdown" href={md} />}
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name}: Writing`} href="/rss.xml" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f7f6" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#151514" />

    <meta property="og:type" content={published ? "article" : "website"} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {published && <meta property="article:published_time" content={published} />}
    {published && <meta property="article:author" content={SITE.url} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <p id="new-tab" hidden>Opens in a new tab.</p>
    <main class:list={["page", wide && "page--wide"]}>
      <slot />
      <footer class="foot">
        <p>
          {SITE.name}, {SITE.location}. Reach me at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
        </p>
        <p>
          For agents, this page is also at <a href={md ?? "/index.md"}>{md ?? "/index.md"}</a> and the
          site is indexed at <a href="/llms.txt">/llms.txt</a>. <a href="/rss.xml">RSS</a>.
        </p>
      </footer>
    </main>
  </body>
</html>
