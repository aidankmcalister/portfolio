---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import Section from "../components/Section.astro";
import TextRow from "../components/TextRow.astro";
import { SITE, EXPERIENCE } from "../data/site";
import { formatDate } from "../lib/date";
import { postHref, getPosts } from "../lib/posts";

const featured = (await getCollection("projects", (p) => p.data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);
const posts = (await getPosts()).slice(0, 3);
const quiet =
  "inline-flex min-h-11 items-center font-mono text-[13px] text-fg-muted underline decoration-control underline-offset-4 transition-colors duration-150 hover:text-fg hover:decoration-fg";
---

<Base>
  <section class="pt-10 md:pt-20">
    <h1 class="max-w-[520px] font-mono text-[22px] leading-8 font-medium text-balance text-fg md:text-[24px] md:leading-9">
      I'm Aidan, a developer advocate and TypeScript engineer.
    </h1>
    <p class="mt-5 max-w-[560px] text-fg-body">
      I work on the docs, tools, and communities that help developers pick up a product. At
      <a href="https://www.prisma.io" class="link" target="_blank" rel="noreferrer" aria-describedby="new-tab">Prisma</a>, I rebuilt the docs and built
      <a href="https://github.com/prisma/create-db" class="link" target="_blank" rel="noreferrer" aria-describedby="new-tab">create-db</a>, a CLI that has been
      used more than 6 million times. I'm looking for my next role in developer relations, frontend, or
      devtools engineering.
    </p>
    <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-1">
      <Button href={`mailto:${SITE.email}`} primary>Email me</Button>
      <a href={SITE.resume} target="_blank" rel="noreferrer" aria-describedby="new-tab" class={quiet}>
        Resume
      </a>
      <a href={SITE.social.linkedin} target="_blank" rel="noreferrer" aria-describedby="new-tab" class={quiet}>
        LinkedIn
      </a>
      <a href={SITE.social.github} target="_blank" rel="noreferrer" aria-describedby="new-tab" class={quiet}>
        GitHub
      </a>
    </div>
  </section>

  <Section title="Experience" id="experience">
    {EXPERIENCE.map((e) => <TextRow href={e.url} title={e.company} desc={e.role} aside={e.date} />)}
  </Section>

  <Section title="Selected work" id="selected-work" link={{ label: "All work", href: "/work" }}>
    {
      featured.map((p) => (
        <TextRow href={p.data.href} title={p.data.title} desc={p.data.summary} />
      ))
    }
  </Section>

  <Section title="Recent writing" id="writing" link={{ label: "All writing", href: "/work#writing" }}>
    {
      posts.map((post) => (
        <TextRow
          href={postHref(post)}
          title={post.data.title}
          byline={post.data.byline}
          desc={post.data.description}
          aside={formatDate(post.data.date)}
        />
      ))
    }
  </Section>
</Base>
