---
import Layout from "../layouts/Layout.astro";
import Row from "../components/Row.astro";
import { SITE, WORK } from "../data/site";

const featured = WORK.find((item) => item.title === "BetterBox");
---

<Layout>
  <section class="pt-10">
    <h1 class="font-mono text-[26px] font-bold tracking-tight text-ink">
      {SITE.name}
    </h1>

    <p class="mt-4 max-w-xl text-body">
      Developer advocate. I write and build the docs, content, and tools around
      developer products. Most recently I led a 400+ page docs rebuild and
      shipped{" "}
      <a href="https://create-db.prisma.io" class="link" target="_blank" rel="noreferrer"
        >create-db</a
      > at Prisma.
    </p>

    <div class="mt-4 flex flex-wrap gap-x-5 gap-y-1 font-mono text-[13px]">
      <a href={SITE.social.github} class="link" target="_blank" rel="noreferrer">GitHub</a>
      <a href={`mailto:${SITE.email}`} class="link">Email</a>
      <a href={SITE.social.linkedin} class="link" target="_blank" rel="noreferrer">LinkedIn</a>
      <a href="/resume.pdf" class="link" target="_blank" rel="noreferrer">Resume</a>
    </div>
  </section>

  {
    featured && (
      <section class="mt-14">
        <h2 class="mb-5 font-mono text-[18px] font-semibold text-ink">Currently</h2>
        <Row
          href={featured.url}
          external={!featured.internal}
          title={featured.title}
          desc={featured.desc}
          meta={featured.company}
        />
      </section>
    )
  }
</Layout>
