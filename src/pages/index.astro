---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Row from "../components/Row.astro";
import { SITE, WORK } from "../data/site";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => (a.data.date < b.data.date ? 1 : -1))
  .slice(0, 3);

const work = WORK.slice(0, 5);

function formatDate(iso: string) {
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  return d.toLocaleDateString("en-US", { year: "numeric", month: "short" });
}
---

<Layout>
  <section class="pt-10">
    <h1 class="font-mono text-[26px] font-bold tracking-tight text-ink">
      {SITE.name}
    </h1>

    <p class="mt-4 max-w-xl text-body">
      Developer advocate. I build docs, tools, and community for developer
      products. Most recently I led a 400+ page docs rebuild and shipped{" "}
      <a href="https://create-db.prisma.io" class="link" target="_blank" rel="noreferrer"
        >create-db</a
      > at Prisma. Before that, front-end and full-stack work at a couple of
      startups.
    </p>

    <div class="mt-4 flex flex-wrap gap-x-5 gap-y-1 font-mono text-[13px]">
      <a href={SITE.social.github} class="link" target="_blank" rel="noreferrer">GitHub</a>
      <a href={`mailto:${SITE.email}`} class="link">Email</a>
      <a href={SITE.social.linkedin} class="link" target="_blank" rel="noreferrer">LinkedIn</a>
      <a href="/resume.pdf" class="link" target="_blank" rel="noreferrer">Resume</a>
    </div>
  </section>

  <section class="mt-14">
    <div class="mb-5 flex items-baseline justify-between">
      <h2 class="font-mono text-[18px] font-semibold text-ink">Work</h2>
      <a href="/work" class="font-mono text-[12.5px] text-muted hover:text-ink">all →</a>
    </div>
    <div class="flex flex-col gap-5">
      {
        work.map((item) => (
          <Row
            href={item.url}
            external={!item.internal}
            title={item.title}
            desc={item.desc}
            meta={item.company}
          />
        ))
      }
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="mt-14">
        <div class="mb-5 flex items-baseline justify-between">
          <h2 class="font-mono text-[18px] font-semibold text-ink">Writing</h2>
          <a href="/blog" class="font-mono text-[12.5px] text-muted hover:text-ink">
            all →
          </a>
        </div>
        <div class="flex flex-col gap-5">
          {posts.map((post) => (
            <Row
              href={
                post.data.external && post.data.link
                  ? post.data.link
                  : `/blog/${post.data.slug}`
              }
              external={post.data.external}
              title={post.data.title}
              desc={post.data.description}
              meta={formatDate(post.data.date)}
            />
          ))}
        </div>
      </section>
    )
  }
</Layout>
