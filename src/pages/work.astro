---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import Section from "../components/Section.astro";
import TextRow from "../components/TextRow.astro";
import Tools from "../components/Tools.astro";
import { formatDate } from "../lib/date";
import { getPosts, postHref } from "../lib/posts";
import { MORE_FROM_PRISMA, OPEN_SOURCE } from "../data/site";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const posts = await getPosts();
---

<Base
  title="Work"
  description="What Aidan McAlister built, shipped, and wrote: create-db, clasp.sh, the Prisma docs rebuild, launch pages, and writing on docs and AI agents."
>
  <PageHeader title="Work" subtitle="Things I built, shipped, and wrote." />

  <Section title="Projects" id="projects">
    {projects.map((p) => <TextRow href={p.data.href} title={p.data.title} desc={p.data.summary} />)}
  </Section>

  <Section title="Writing" id="writing">
    {
      posts.map((post) => (
        <TextRow
          href={postHref(post)}
          title={post.data.title}
          byline={post.data.byline}
          desc={post.data.description}
          aside={formatDate(post.data.date)}
        />
      ))
    }
  </Section>

  <Section title="Other work at Prisma" id="other-prisma">
    {MORE_FROM_PRISMA.map((r) => <TextRow {...r} />)}
  </Section>

  <Section title="Open source" id="open-source">
    {OPEN_SOURCE.map((r) => <TextRow {...r} />)}
  </Section>

  <Section title="Tools I use often" id="tools">
    <Tools />
  </Section>
</Base>
