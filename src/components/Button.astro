---
// 44px link-button. Only "Email me" is primary.
interface Props {
  href: string;
  primary?: boolean;
  external?: boolean;
}

const { href, primary, external } = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noreferrer" : undefined}
  aria-describedby={external ? "new-tab" : undefined}
  class:list={[
    "inline-flex h-11 items-center justify-center rounded-sm border px-4 font-mono text-[13px] transition-colors duration-150",
    primary
      ? "border-fg bg-fg font-medium text-bg hover:border-black hover:bg-black"
      : "border-control text-fg hover:border-fg-subtle hover:bg-surface",
  ]}
>
  <slot />
</a>
