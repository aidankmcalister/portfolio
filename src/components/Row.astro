---
// A list item: title on the left, muted meta on the right, description below.
// When href is set, the whole card is the click target.
interface Props {
  href?: string;
  external?: boolean;
  title: string;
  desc?: string;
  meta?: string;
}

const { href, external, title, desc, meta } = Astro.props;
const linkAttrs = external ? { target: "_blank", rel: "noreferrer" } : {};
---

{
  href ? (
    <a {...linkAttrs} href={href} class="group block">
      <div class="flex items-baseline justify-between gap-4">
        <span class="font-medium text-ink underline-offset-4 decoration-muted group-hover:underline">
          {title}
          {external && <span class="text-[0.85em] text-muted"> ↗</span>}
        </span>
        {meta && <span class="shrink-0 text-[12.5px] text-muted">{meta}</span>}
      </div>
      {desc && <p class="mt-1 text-[13.5px] leading-relaxed text-muted">{desc}</p>}
    </a>
  ) : (
    <div>
      <div class="flex items-baseline justify-between gap-4">
        <span class="font-medium text-ink">{title}</span>
        {meta && <span class="shrink-0 text-[12.5px] text-muted">{meta}</span>}
      </div>
      {desc && <p class="mt-1 text-[13.5px] leading-relaxed text-muted">{desc}</p>}
    </div>
  )
}
