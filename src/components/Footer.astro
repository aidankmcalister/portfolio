---
import { SITE } from "../data/site";

const small =
  "inline-flex min-h-11 items-center font-mono text-[12px] text-fg-muted transition-colors duration-150 hover:text-fg";
---

<footer class="mt-24">
  <div
    class="mx-auto flex max-w-[800px] flex-col gap-2 px-5 pt-8 pb-10 md:flex-row md:items-center md:justify-between"
  >
    <p class="text-fg-body">
      Open to new roles. Say hi at <a href={`mailto:${SITE.email}`} class="link">{SITE.email}</a>
    </p>
    <div class="flex gap-5">
      <a href={SITE.social.github} target="_blank" rel="noreferrer" class={small}>
        GitHub<span class="sr-only"> (opens in new tab)</span>
      </a>
      <a href={SITE.social.linkedin} target="_blank" rel="noreferrer" class={small}>
        LinkedIn<span class="sr-only"> (opens in new tab)</span>
      </a>
      <a href={SITE.resume} target="_blank" rel="noreferrer" class={small}>
        Resume<span class="sr-only"> (opens in new tab)</span>
      </a>
    </div>
  </div>
</footer>
